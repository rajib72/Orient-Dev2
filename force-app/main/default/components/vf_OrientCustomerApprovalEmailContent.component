<apex:component controller="Ctrl_OrientCustomerApprovalEmailContent" access="global">
    <apex:attribute name="approvalId"
        type="Id"
        description="Tagged Approval Hierarchy Id"
        assignTo="{!taggedApprovalId}" />

    <div style="font-family:Arial,Helvetica,sans-serif;color:#2e2e2e;font-size:14px;line-height:1.5;">
        <div style="margin-bottom:18px;">
            Hello <strong><apex:outputText value="{!pendingWithName}" /></strong>,<br/>
            A Customer Profile change request is waiting for your approval.
        </div>

        <div style="border:1px solid #f0c9cc;border-radius:12px;background:#fff5f5;padding:16px;margin-bottom:18px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <tr>
                    <td width="50%" style="padding:4px 12px 10px 0;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Customer Name</div>
                        <div style="font-size:16px;font-weight:bold;margin-top:3px;">
                            <apex:outputText value="{!customerName}" />
                        </div>
                    </td>
                    <td width="50%" style="padding:4px 0 10px 12px;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Change Request</div>
                        <div style="font-size:16px;font-weight:bold;margin-top:3px;">
                            <apex:outputText value="{!changeRequestName}" />
                        </div>
                    </td>
                </tr>
                <tr>
                    <td width="50%" style="padding:8px 12px 4px 0;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Approval Store</div>
                        <div style="font-weight:bold;margin-top:3px;">
                            <apex:outputText value="{!approvalStoreName}" />
                        </div>
                    </td>
                    <td width="50%" style="padding:8px 0 4px 12px;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Location Code</div>
                        <div style="font-weight:bold;margin-top:3px;">
                            <apex:outputText value="{!locationCode}" />
                        </div>
                    </td>
                </tr>
                <tr>
                    <td width="50%" style="padding:8px 12px 4px 0;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Submitted By</div>
                        <div style="font-weight:bold;margin-top:3px;">
                            <apex:outputText value="{!submittedByName}" />
                        </div>
                    </td>
                    <td width="50%" style="padding:8px 0 4px 12px;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Submitted Date &amp; Time</div>
                        <div style="font-weight:bold;margin-top:3px;">
                            <apex:outputText value="{!submittedDateTimeIST}" />
                        </div>
                    </td>
                </tr>
                <tr>
                    <td width="50%" style="padding:8px 12px 4px 0;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Current Approval Level</div>
                        <div style="font-weight:bold;margin-top:3px;">
                            <apex:outputText value="{!currentApprovalLevel}" />
                        </div>
                    </td>
                    <td width="50%" style="padding:8px 0 4px 12px;vertical-align:top;">
                        <div style="color:#9c5a60;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.4px;">Pending With</div>
                        <div style="font-weight:bold;margin-top:3px;color:#a61d28;">
                            <apex:outputText value="{!pendingWithName}" />
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <div style="margin-bottom:18px;border:1px solid #f0c9cc;border-radius:12px;overflow:hidden;">
            <div style="background:#b51f2a;color:#ffffff;font-size:14px;font-weight:bold;padding:10px 14px;">
                Requested Changes ({!changeCount})
            </div>

            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <thead>
                    <tr style="background:#fff7f8;">
                        <th align="left" style="padding:10px;border-bottom:1px solid #f0c9cc;color:#9c5a60;font-size:11px;text-transform:uppercase;">Section</th>
                        <th align="left" style="padding:10px;border-bottom:1px solid #f0c9cc;color:#9c5a60;font-size:11px;text-transform:uppercase;">Field</th>
                        <th align="left" style="padding:10px;border-bottom:1px solid #f0c9cc;color:#9c5a60;font-size:11px;text-transform:uppercase;">Existing Value</th>
                        <th align="left" style="padding:10px;border-bottom:1px solid #f0c9cc;color:#9c5a60;font-size:11px;text-transform:uppercase;">Requested Value</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!changeRows}" var="item">
                        <tr>
                            <td style="padding:10px;border-bottom:1px solid #f4e3e5;vertical-align:top;">
                                <apex:outputText value="{!item.sectionName}" />
                            </td>
                            <td style="padding:10px;border-bottom:1px solid #f4e3e5;vertical-align:top;font-weight:bold;">
                                <apex:outputText value="{!item.fieldLabel}" />
                            </td>
                            <td style="padding:10px;border-bottom:1px solid #f4e3e5;vertical-align:top;background:#fffafa;white-space:pre-wrap;word-break:break-word;">
                                <apex:outputText value="{!item.oldValue}" />
                            </td>
                            <td style="padding:10px;border-bottom:1px solid #f4e3e5;vertical-align:top;background:#fff4f5;color:#8f1721;font-weight:bold;white-space:pre-wrap;word-break:break-word;">
                                <apex:outputText value="{!item.newValue}" />
                            </td>
                        </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </div>

        <div style="border:1px solid #f0c9cc;border-radius:12px;background:#fff9f9;padding:14px 16px;margin-bottom:20px;">
            <div style="color:#b51f2a;font-size:12px;font-weight:bold;text-transform:uppercase;margin-bottom:6px;">Change Reason</div>
            <div style="white-space:pre-wrap;word-break:break-word;">
                <apex:outputText value="{!changeReason}" />
            </div>
        </div>

        <div style="text-align:center;margin:24px 0 8px;">
            <apex:outputLink value="{!customerUrl}"
                style="display:inline-block;background:#c81724;color:#ffffff;text-decoration:none;font-weight:bold;padding:11px 24px;border-radius:22px;margin:0 5px 8px;">
                Open Customer
            </apex:outputLink>

            <apex:outputLink value="{!changeRequestUrl}"
                style="display:inline-block;background:#ffffff;color:#a61d28;text-decoration:none;font-weight:bold;padding:10px 22px;border:1px solid #dbaeb2;border-radius:22px;margin:0 5px 8px;">
                View Change Request
            </apex:outputLink>
        </div>

        <div style="margin-top:10px;text-align:center;color:#765f61;font-size:11px;line-height:1.4;">
            The Open Customer button takes you directly to the Salesforce Customer record.
        </div>
    </div>
</apex:component>